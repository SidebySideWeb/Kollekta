PORT=3000
ADMIN_PASSWORD=test123
SESSION_COOKIE_SECRET=dev-secret-change-me

# Όνομα εταιρείας που βλέπουν οι πελάτες (white-label). Κενό = fallback Kollekta μόνο στο admin/login.
COMPANY_NAME=Moutaki
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
ACCENT_COLOR=#2563EB
# Default brand lockup (mark + wordmark). Override for white-label clients.
LOGO_PATH=/shared/kollekta-lockup.svg
FOOTER_TEXT=
# Public URL του client
APP_PUBLIC_URL=https://moutaki.kollekta.gr

# Email του superadmin (δημιουργείται/συγχρονίζεται με το ADMIN_PASSWORD).
# Μόνο αυτός προσθέτει/διαγράφει άλλους διαχειριστές· δεν μπορεί να διαγραφεί από την εφαρμογή.
ADMIN_EMAIL=admin@example.com

# Τοπική ανάπτυξη: APP_PUBLIC_URL=http://localhost:3000

# Πάροχος email: console (προεπιλογή) | resend | smtp
EMAIL_PROVIDER=console
RESEND_API_KEY=
# From αυτόματα: Moutaki <moutaki@kollekta.gr>
# (client subdomain → local-part, parent kollekta.gr → domain — verify kollekta.gr once in Resend)
# EMAIL_FROM_DOMAIN=kollekta.gr
# EMAIL_LOCAL_PART=moutaki
# EMAIL_FROM="Moutaki" <moutaki@kollekta.gr>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Πάροχος SMS/Viber/WhatsApp: console (προεπιλογή) ή yuboto ή twilio
MESSAGING_PROVIDER=console
MESSAGING_SENDER_ID=
YUBOTO_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Αρχειοθέτηση full-res. Αν κενό, παράγεται από PLAN:
#   basic=12, pro=24, business=null (ποτέ).
# DEFAULT_RETENTION_MONTHS=12
# DEFAULT_RETENTION_MONTHS=null
RETENTION_AUTO_PURGE=false
STORAGE_WARN_PERCENT=75
STORAGE_CRITICAL_PERCENT=90

# Απενεργοποίηση rate limit στο local dev (προαιρετικό)
# RATE_LIMIT_DISABLED=true

# Όρια προσπαθειών σύνδεσης / επαναφοράς (προαιρετικό)
# RATE_LIMIT_LOGIN_MAX_FAILURES=15
# RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# RATE_LIMIT_LOGIN_MAX_PER_IP=60
# RATE_LIMIT_RESET_MAX_PER_PHONE=10
# RATE_LIMIT_RESET_MAX_PER_IP=30

# Επεξεργασία εικόνων (προαιρετικό)
# Παράλληλη επεξεργασία ανά παρτίδα ανεβάσματος (1–4)
# IMAGE_PROCESS_CONCURRENCY=3
# Παράλληλη δημιουργία thumbs στο background
# IMAGE_THUMB_CONCURRENCY=2

# Όριο χώρου ανά instance (GB). 0 = χωρίς έλεγχο.
# Προειδοποίηση / πλήρες: χρησιμοποιούνται STORAGE_WARN_PERCENT και STORAGE_CRITICAL_PERCENT παραπάνω.
QUOTA_GB=10

# Πακέτο λειτουργιών: basic | pro | business (default basic)
PLAN=basic
# Προαιρετικά overrides (true/false). Κενό = παράγωγα από PLAN.
# FEATURE_PRODUCT_CODES=
# FEATURE_ORDER_FILTERING=
# FEATURE_TAGS=
# FEATURE_RETENTION_OVERRIDE=
